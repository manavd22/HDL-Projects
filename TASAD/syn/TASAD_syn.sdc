###################################################################

# Created by write_sdc on Fri Aug  7 12:13:44 2026

###################################################################
set sdc_version 2.2

set_units -time ns -resistance MOhm -capacitance fF -voltage V -current mA
set_operating_conditions -max slow -max_library                                \
nangate45_css_slow.db:NangateOpenCellLibrary\
                         -min fast -min_library                                \
nangate45_css_fast.db:NangateOpenCellLibrary
set_max_fanout 16 [current_design]
set_load -pin_load 1 [get_ports {A[15]}]
set_load -pin_load 1 [get_ports {A[14]}]
set_load -pin_load 1 [get_ports {A[13]}]
set_load -pin_load 1 [get_ports {A[12]}]
set_load -pin_load 1 [get_ports {A[11]}]
set_load -pin_load 1 [get_ports {A[10]}]
set_load -pin_load 1 [get_ports {A[9]}]
set_load -pin_load 1 [get_ports {A[8]}]
set_load -pin_load 1 [get_ports {A[7]}]
set_load -pin_load 1 [get_ports {A[6]}]
set_load -pin_load 1 [get_ports {A[5]}]
set_load -pin_load 1 [get_ports {A[4]}]
set_load -pin_load 1 [get_ports {A[3]}]
set_load -pin_load 1 [get_ports {A[2]}]
set_load -pin_load 1 [get_ports {A[1]}]
set_load -pin_load 1 [get_ports {A[0]}]
set_load -pin_load 1 [get_ports valid]
set_load -pin_load 1 [get_ports Qbusy]
set_load -pin_load 1 [get_ports Kbusy]
set_ideal_network [get_ports clk1]
set_ideal_network [get_ports clk2]
create_clock [get_ports clk1]  -period 640  -waveform {0 320}
set_clock_latency 0.5  [get_clocks clk1]
set_clock_uncertainty 0.1  [get_clocks clk1]
create_clock [get_ports clk2]  -period 10  -waveform {0 5}
set_clock_latency 0.5  [get_clocks clk2]
set_clock_uncertainty 0.1  [get_clocks clk2]
set_input_delay -clock clk1  1  [get_ports {Q[7]}]
set_input_delay -clock clk1  1  [get_ports {Q[6]}]
set_input_delay -clock clk1  1  [get_ports {Q[5]}]
set_input_delay -clock clk1  1  [get_ports {Q[4]}]
set_input_delay -clock clk1  1  [get_ports {Q[3]}]
set_input_delay -clock clk1  1  [get_ports {Q[2]}]
set_input_delay -clock clk1  1  [get_ports {Q[1]}]
set_input_delay -clock clk1  1  [get_ports {Q[0]}]
set_input_delay -clock clk2  1  [get_ports {K[7]}]
set_input_delay -clock clk2  1  [get_ports {K[6]}]
set_input_delay -clock clk2  1  [get_ports {K[5]}]
set_input_delay -clock clk2  1  [get_ports {K[4]}]
set_input_delay -clock clk2  1  [get_ports {K[3]}]
set_input_delay -clock clk2  1  [get_ports {K[2]}]
set_input_delay -clock clk2  1  [get_ports {K[1]}]
set_input_delay -clock clk2  1  [get_ports {K[0]}]
set_output_delay -clock clk1  1  [get_ports {A[15]}]
set_output_delay -clock clk1  1  [get_ports {A[14]}]
set_output_delay -clock clk1  1  [get_ports {A[13]}]
set_output_delay -clock clk1  1  [get_ports {A[12]}]
set_output_delay -clock clk1  1  [get_ports {A[11]}]
set_output_delay -clock clk1  1  [get_ports {A[10]}]
set_output_delay -clock clk1  1  [get_ports {A[9]}]
set_output_delay -clock clk1  1  [get_ports {A[8]}]
set_output_delay -clock clk1  1  [get_ports {A[7]}]
set_output_delay -clock clk1  1  [get_ports {A[6]}]
set_output_delay -clock clk1  1  [get_ports {A[5]}]
set_output_delay -clock clk1  1  [get_ports {A[4]}]
set_output_delay -clock clk1  1  [get_ports {A[3]}]
set_output_delay -clock clk1  1  [get_ports {A[2]}]
set_output_delay -clock clk1  1  [get_ports {A[1]}]
set_output_delay -clock clk1  1  [get_ports {A[0]}]
set_output_delay -clock clk1  1  [get_ports valid]
set_output_delay -clock clk1  1  [get_ports Qbusy]
set_output_delay -clock clk2  1  [get_ports Kbusy]
set_clock_groups  -asynchronous -name clk1_1  -group [get_clocks clk1] -group  \
[get_clocks clk2]
set_input_transition -max 0.05  [get_ports {Q[7]}]
set_input_transition -min 0.05  [get_ports {Q[7]}]
set_input_transition -max 0.05  [get_ports {Q[6]}]
set_input_transition -min 0.05  [get_ports {Q[6]}]
set_input_transition -max 0.05  [get_ports {Q[5]}]
set_input_transition -min 0.05  [get_ports {Q[5]}]
set_input_transition -max 0.05  [get_ports {Q[4]}]
set_input_transition -min 0.05  [get_ports {Q[4]}]
set_input_transition -max 0.05  [get_ports {Q[3]}]
set_input_transition -min 0.05  [get_ports {Q[3]}]
set_input_transition -max 0.05  [get_ports {Q[2]}]
set_input_transition -min 0.05  [get_ports {Q[2]}]
set_input_transition -max 0.05  [get_ports {Q[1]}]
set_input_transition -min 0.05  [get_ports {Q[1]}]
set_input_transition -max 0.05  [get_ports {Q[0]}]
set_input_transition -min 0.05  [get_ports {Q[0]}]
set_input_transition -max 0.05  [get_ports {K[7]}]
set_input_transition -min 0.05  [get_ports {K[7]}]
set_input_transition -max 0.05  [get_ports {K[6]}]
set_input_transition -min 0.05  [get_ports {K[6]}]
set_input_transition -max 0.05  [get_ports {K[5]}]
set_input_transition -min 0.05  [get_ports {K[5]}]
set_input_transition -max 0.05  [get_ports {K[4]}]
set_input_transition -min 0.05  [get_ports {K[4]}]
set_input_transition -max 0.05  [get_ports {K[3]}]
set_input_transition -min 0.05  [get_ports {K[3]}]
set_input_transition -max 0.05  [get_ports {K[2]}]
set_input_transition -min 0.05  [get_ports {K[2]}]
set_input_transition -max 0.05  [get_ports {K[1]}]
set_input_transition -min 0.05  [get_ports {K[1]}]
set_input_transition -max 0.05  [get_ports {K[0]}]
set_input_transition -min 0.05  [get_ports {K[0]}]
set_false_path   -from [get_ports rst]
